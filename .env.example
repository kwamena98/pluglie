# Copy this file to `.env.local` and fill in real values.
# Vite only exposes env vars prefixed with VITE_ to the client.

# Formspree form ID (the part after /f/ in your endpoint URL).
# Sign up at https://formspree.io, create a form, then paste the ID here.
# Example: if your endpoint is https://formspree.io/f/xnnzlevp, use xnnzlevp.
VITE_FORMSPREE_ID=
